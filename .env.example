# App Configuration
APP_ENV=development

# Sentry Configuration
SENTRY_DSN=PLACEHOLDER_SENTRY_DSN
SENTRY_ORG=trao
SENTRY_PROJECT=trao-mobile

# Trao backend API, no trailing slash. Android emulator: http://10.0.2.2:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Public media host for avatar storage keys
EXPO_PUBLIC_R2_PUBLIC_URL=

# Firebase Web app configuration (public client identifiers, not secrets)
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-firebase-project-id
# Realtime Database URL, used for chat typing/presence and the sync doorbell (chat falls back to polling without it)
EXPO_PUBLIC_FIREBASE_DATABASE_URL=https://your-project-default-rtdb.firebaseio.com
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-web-api-key

# Google sign-in: the OAuth client of type "Web application" (Firebase console > Authentication > Google)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
