{
  "expo": {
    "name": "Trao",
    "slug": "trao-mobile",
    "scheme": "trao",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.trao.mobile",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.trao.mobile",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "trao",
          "project": "trao-mobile"
        }
      ],
      "expo-sqlite",
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Trao cần quyền truy cập ảnh để chọn ảnh đại diện, ảnh đồ và gửi ảnh.",
          "cameraPermission": "Trao cần dùng máy ảnh để chụp ảnh đại diện, ảnh đồ và ảnh gửi đi.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Để hiện đồ gần bạn và tính khoảng cách."
        }
      ],
      "expo-font",
      "expo-video",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.PLACEHOLDER_IOS_CLIENT_ID"
        }
      ],
      [
        "react-native-fbsdk-next",
        {
          "appID": "PLACEHOLDER_FACEBOOK_APP_ID",
          "clientToken": "PLACEHOLDER_FACEBOOK_CLIENT_TOKEN",
          "displayName": "Trao",
          "scheme": "fbPLACEHOLDER_FACEBOOK_APP_ID",
          "iosUserTrackingPermission": false
        }
      ]
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "7978d587-c35c-424c-81b8-42872c70edf8"
      }
    },
    "owner": "aduycuong"
  }
}
